        android:fillColor="#1E88E5"
        android:pathData="M24,24 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0" />
    <!-- Center dot -->
    <path
        android:fillColor="#FFFFFF"
